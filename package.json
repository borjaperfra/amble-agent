{
  "name": "amble",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:model": "node --env-file=.env.local scripts/check-model.mjs",
    "measure": "node --env-file=.env.local scripts/measure-run.mjs",
