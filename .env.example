# Amble — environment
#
#   copy .env.example .env.local      (Windows)
#   cp   .env.example .env.local      (macOS / Linux)
#
# Then fill in AMBLE_MODEL_API_KEY and restart the dev server.
# .env.local is gitignored. Never commit a real key.


# ── Mode ──────────────────────────────────────────────────────────────
# "true" runs the real User Zero pipeline: sources are read for real,
# every claim carries provenance, and all demo fixtures are disabled.
# Anything else (or unset) runs the fixture demo journey.
AMBLE_USER_ZERO=true


# ── Model ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint.
AMBLE_MODEL_PROVIDER=openai-compatible

# Helmcode's API is OpenAI-compatible and runs in the EU.
# Note the /v1 — the client appends /chat/completions to this base.
AMBLE_MODEL_BASE_URL=https://api.helmcode.com/v1

# deepseek-v4-flash is the reasoning model. Amble asks it to weigh what
# evidence does and does not prove, which is the whole point of the graph.
AMBLE_MODEL_ID=deepseek-v4-flash

# Server-side only. Never exposed to the browser.
AMBLE_MODEL_API_KEY=


# ── Structured output ─────────────────────────────────────────────────
# Send response_format: json_object. Helmcode validates it on qwen3.6 and
# gemma4 only, so it must be OFF for deepseek-v4-flash. With it off, the
# prompts still demand JSON, the parser digs the object out of whatever
# wrapping comes back, and Zod rejects anything that does not fit.
AMBLE_MODEL_JSON_MODE=off


# ── Reasoning ─────────────────────────────────────────────────────────
# Send reasoning_effort. deepseek-v4-flash only — other models reject it.
AMBLE_MODEL_REASONING=on

# Default depth for tasks that do not ask for their own. Tasks that judge
# evidence (capability assessment, interview planning) already ask for
# "high"; mechanical extraction asks for "low".
AMBLE_MODEL_REASONING_EFFORT=medium

# A reasoning trace burns tokens before the JSON starts. Too low and the
# answer is truncated mid-object; the run is recorded as truncated rather
# than blamed on bad JSON.
AMBLE_MODEL_MAX_TOKENS=8000

# Reasoning is slower than a straight answer, and capability assessment
# sends every piece of evidence at once.
AMBLE_MODEL_TIMEOUT_MS=180000


# ── Speech to text ────────────────────────────────────────────────────
# Voice answers in the Rep interview. Same OpenAI-compatible shape:
# POST {base}/audio/transcriptions as multipart/form-data.
#
# Helmcode limits: 25 MB and roughly 2 minutes of audio per request.
# Longer audio returns 524, so the recorder caps what it will send.
AMBLE_STT_BASE_URL=https://api.helmcode.com/v1
AMBLE_STT_MODEL=whisper

# Optional. Falls back to AMBLE_MODEL_API_KEY when left empty.
AMBLE_STT_API_KEY=

# ISO-639-1 hint for the transcriber. Leave empty to auto-detect.
AMBLE_STT_LANGUAGE=es
