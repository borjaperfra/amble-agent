# AMBLE — configuration
# Copy to .env.local and fill in. Never commit real keys.

# Model provider (OpenAI-compatible chat completions API).
AMBLE_MODEL_PROVIDER=openai-compatible

# Base URL of an OpenAI-compatible endpoint.
# DeepSeek's documented OpenAI-compatible base is https://api.deepseek.com
AMBLE_MODEL_BASE_URL=https://api.deepseek.com

# The exact model identifier to use (e.g. your DeepSeek V4.1 Flash deployment id).
# Intentionally has no default: set it explicitly.
AMBLE_MODEL_ID=

# Server-side only. Never exposed to the browser.
AMBLE_MODEL_API_KEY=

# Optional. Raises the GitHub read limit from 60 to 5,000 requests/hour.
AMBLE_GITHUB_TOKEN=
